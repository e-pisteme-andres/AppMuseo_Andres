{
  "name": "app-museo-ar",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-tunnel.ps1 -Tunnel none",
    "dev:tunnel": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-tunnel.ps1 -Tunnel localtunnel",
    "dev:cloudflare": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-tunnel.ps1 -Tunnel cloudflared",
    "build": "tsc -b && vite build",
    "build:panorama-module": "powershell -Command \"$env:VITE_BUILD_TARGET='panorama-module'; node .\\node_modules\\typescript\\bin\\tsc -b; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node .\\node_modules\\vite\\bin\\vite.js build\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "download:panoramas": "node scripts/download-panorama-assets.mjs",
    "generate:assets": "node scripts/generate-assets.mjs && node scripts/generate-ios-assets.mjs",
    "generate:ios-assets": "node scripts/generate-ios-assets.mjs",
    "validate:ios": "node scripts/validate-ios-project.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.180.0",
    "@types/webxr": "^0.5.23",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
